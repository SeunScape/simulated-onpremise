# Placeholders only. The real .env is generated on the server by scripts/deploy-fineract.sh
# (mode 600, never copied back, gitignored).

# PostgreSQL superuser (root) password
POSTGRES_PASSWORD=change-me

# Fineract application DB user (postgres) password; also used for the default tenant DB
FINERACT_DB_PASS=change-me

# Key Fineract uses to encrypt tenant DB passwords in fineract_tenants
FINERACT_DEFAULT_MASTER_PASSWORD=change-me
